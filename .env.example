# Kopiere diese Datei nach .env und trage lokale Werte ein:
#   cp .env.example .env
#
# .env wird von Git ignoriert und gehört nicht ins Repo.
# Keine echten Produktions-Passwörter hier eintragen.

# PHP / App → MySQL
DB_HOST=mysql
DB_NAME=db_DPLChk2
DB_USER=
DB_PASSWORD=
DB_PORT=3306

# MySQL-Container (docker compose)
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=db_TestKs
MYSQL_USER=
MYSQL_PASSWORD=

# Optional
RULE_TIMEOUT=10
